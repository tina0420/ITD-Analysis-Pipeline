def tidy_stages(stage_counts):
    stage_label = ["Stage I" , "Stage II", "Stage III", "Stage IV"]*2
    stage_info_to_plot = pd.DataFrame(stage_label, columns=["Stage"], index=None)
    stage_info_to_plot["ITD"] = ["ITD+"] *4 +["ITD−"] *4

    stage_info_to_plot["Counts"] = stage_counts

    positive_total = sum(stage_info_to_plot.iloc[0:4,2])
    negative_total = sum(stage_info_to_plot.iloc[4:8,2])
    stage_info_to_plot["Percnetage"] = 0
    for i in range(stage_info_to_plot.shape[0]):
        if stage_info_to_plot.iloc[i,1] == "ITD+":
            total_number = positive_total
            per = round(stage_info_to_plot.iloc[i,2]/total_number*100,2)
            stage_info_to_plot.iat[i,3] = per
        else:
            total_number = negative_total
            per = round(stage_info_to_plot.iloc[i,2]/total_number*100,2)
            stage_info_to_plot.iat[i,3] = per
    return stage_info_to_plot

def plot_stages(cancer, stages_df):
    stage_info_to_plot = stages_df
    stage_1_p = stage_info_to_plot.iloc[0,3]
    stage_1_n = stage_info_to_plot.iloc[4,3]
    stage_2_p = stage_info_to_plot.iloc[1,3]
    stage_2_n = stage_info_to_plot.iloc[5,3]
    stage_3_p = stage_info_to_plot.iloc[2,3]
    stage_3_n = stage_info_to_plot.iloc[6,3]
    stage_4_p = stage_info_to_plot.iloc[3,3]
    stage_4_n = stage_info_to_plot.iloc[7,3]

    total_positive_patient = sum(stage_info_to_plot.loc[0:3,"Counts"])
    total_negative_patient = sum(stage_info_to_plot.loc[4:7,"Counts"])

    Table = np.array([[stage_1_p, stage_1_n],
                    [stage_2_p, stage_2_n],
                    [stage_3_p, stage_3_n],
                    [stage_4_p, stage_4_n]])
    chi2, p, dof, ex = stats.chi2_contingency(Table, correction=False)

    n = np.arange(2)
    plt.figure(figsize=(12,9))
    plt.title(cancer, fontsize=35, pad=10)
    plt.ylim([0,119])
    plt.xticks(n, ("ITD+(n="+str(total_positive_patient)+")", "ITD−(n="+str(total_negative_patient)+")"), fontsize=35)
    plt.yticks(fontsize=20)
    plt.ylabel("Percentage (%)", fontsize=30)
    b1 = plt.bar(n, [stage_1_p, stage_1_n],color='#5975a4')
    plt.text(n[0],stage_1_p/2,stage_1_p, horizontalalignment="center", weight="bold", fontsize=25)
    plt.text(n[1],stage_1_n/2,stage_1_n, horizontalalignment="center", weight="bold", fontsize=25)
